# mypanel3 - environment variables
# Copy to .env and fill in. install.sh manages /etc/mypanel3/mypanel3.env
# (panel) and /etc/mypanel3/node.env (agent) on hosts it configures; this file
# is for docker compose and manual runs.

# Database
# install.sh creates the local role/DB automatically.
DATABASE_URL=postgres://mypanel3:change-me@127.0.0.1:5432/mypanel3
DB_MAX_CONNECTIONS=10

# Server
API_HOST=0.0.0.0
API_PORT=3000
# Public URL of the panel (install-command, subscription links, Telegram).
API_URL=https://panel.example.com
# Optional separate base URL for subscription links (sub.example.com).
# Defaults to API_URL when unset. The sub domain must reverse-proxy to the
# same panel upstream; add it to CORS_ORIGINS as well.
#SUB_URL=https://sub.example.com
# Browser origin(s) allowed by CORS; comma-separated. FRONTEND_URL is the
# fallback when CORS_ORIGINS is unset.
FRONTEND_URL=https://panel.example.com
#CORS_ORIGINS=https://panel.example.com,https://www.panel.example.com

# production enables Secure cookies and requires strong secrets below.
NODE_ENV=production

# Secrets (REQUIRED in production)
# Generate: openssl rand -hex 32
# JWT_SECRET must be >= 32 chars; ENCRYPTION_KEY is 32 bytes as 64 hex or
# base64. Keep the existing value when migrating so protocol credentials decrypt.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=

# Proxy / networking
# Honor X-Forwarded-For only when the panel sits behind a reverse proxy.
TRUST_PROXY=true
# Rate limiting (per window, per key). RATE_LIMIT_WINDOW is in MILLISECONDS
# (default 900000 = 15 min) - a small value like 60 disables the limiter.
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Body size cap for API requests (bytes)
#BODY_LIMIT_BYTES=1048576
# Panel->node HTTP calls accept private/loopback/link-local node addresses by
# default (true) so same-host and LAN nodes work out of the box. Set to false
# to block panel->node requests to private/reserved ranges in hardened setups
# where every node has a public IP (enforced at connect time as well).
#ALLOW_PRIVATE_NODES=false
# Allow plain HTTP (non-TLS) worker-API calls to non-loopback nodes.
# Required when a remote node uses --tls-mode none.
#NODE_API_PLAINTEXT=false

# Metrics
PROMETHEUS_ENABLED=true
# Bearer token protecting GET /metrics. Required: without it the endpoint
# answers 403. Generate one with: openssl rand -hex 24
METRICS_TOKEN=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to run admin bot commands.
TELEGRAM_ADMIN_IDS=

# Backups
BACKUP_ENABLED=false
# 5-field cron (minute hour dom mon dow) - seconds are added by the panel.
BACKUP_INTERVAL="0 3 * * *"
#BACKUP_DIR=/var/lib/mypanel3/backups
BACKUP_RETENTION=14
# Telegram (optional)
BACKUP_TELEGRAM_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
# S3 (optional). Endpoint defaults to https://<bucket>.s3.<region>.amazonaws.com
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
#BACKUP_S3_ENDPOINT=

# Logging
RUST_LOG=info
LOG_FORMAT=text
#DATA_DIR=/var/lib/mypanel3
#PG_DUMP_BIN=pg_dump

# Node agent (install.sh writes these to /etc/mypanel3/node.env)
# Panel URL the agent connects to.
#MASTER_URL=https://panel.example.com
# Node secret from the panel (Nodes -> Install command). Required, 16-256 chars.
#NODE_RPC_SECRET=
#NODE_SECRET=
#NODE_HOST=example-node-1.example.com
#NODE_NAME=Example node
#WORKER_HOST=0.0.0.0
#WORKER_PORT=2222
# Optional comma-separated IP/CIDR allow-list for panel->node API calls (e.g. 203.0.113.10)
#ALLOWED_PANEL_IPS=
#PANEL_IP=
#CONFIG_DIR=/var/lib/mypanel3-node
#XRAY_BIN=/usr/local/bin/xray
#SINGBOX_BIN=/usr/local/bin/sing-box
#NAIVE_BIN=/usr/local/bin/caddy-naive
#MIERU_BIN=/usr/local/bin/mita
#XRAY_LOCATION_ASSET=/usr/local/share/xray
