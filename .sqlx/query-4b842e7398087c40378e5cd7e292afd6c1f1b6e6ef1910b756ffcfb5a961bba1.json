  "query": "SELECT id, \"type\"::text AS ty, title, message, read, metadata,\n                  \"createdAt\" AS created_at\n           FROM \"Notification\"\n           WHERE (\"targetUserId\" IS NULL OR \"targetUserId\" = $1)\n             AND ($2::text IS NULL OR \"targetResellerId\" IS NULL OR \"targetResellerId\" = $2)\n           ORDER BY \"createdAt\" DESC, id DESC\n           LIMIT 50",
