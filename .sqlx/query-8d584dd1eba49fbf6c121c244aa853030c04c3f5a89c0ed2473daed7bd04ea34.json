  "db_name": "PostgreSQL",
  "query": "SELECT id, username, \"telegramId\" AS telegram_id, \"expireAt\" AS expire_at,\n                  \"usedTraffic\" AS used_traffic, \"trafficLimit\" AS traffic_limit\n           FROM \"Client\"\n           WHERE banned = false AND \"telegramId\" IS NOT NULL\n             AND \"expireAt\" IS NOT NULL AND \"expireAt\" >= $1 AND \"expireAt\" <= $2\n           ORDER BY \"expireAt\" ASC",
